    {
      "type": "timeseries",
      "title": "Queries per interval",
      "description": "Approximate: change in Pi-hole's rolling 24 h counters, so queries ageing out of the window are netted off (and negatives clamped to 0).",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "clamp_min(delta(pihole_dns_queries_today{job=\"pihole\"}[$__interval]), 0)",
          "legendFormat": "all"
        },
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "clamp_min(delta(pihole_ads_blocked_today{job=\"pihole\"}[$__interval]), 0)",
          "legendFormat": "blocked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
