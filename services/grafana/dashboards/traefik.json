{
  "uid": "traefik",
  "title": "Traefik",
  "tags": [
    "homelab",
    "traefik",
    "http"
  ],
  "description": "Requests through the reverse proxy, per service. Plex and Home Assistant only show up here when reached via their https://*.domain names, not direct IP:port.",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
