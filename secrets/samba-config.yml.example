# Copy to secrets/samba-config.yml, fill in values, then run: make encrypt-secrets
# uid/gid 1000 is standard for the first non-root user on Ubuntu

auth:
  - user: yourname
    group: yourname
    uid: 1000
    gid: 1000
    password: changeme

global:
  - "force user = yourname"
  - "force group = yourname"

share:
  - name: files
    path: /files
    browsable: yes
    readonly: no
    guestok: no
    validusers: yourname
    writelist: yourname
    veto: no

  - name: timemachine
    path: /timemachine
    browsable: yes
    readonly: no
    guestok: no
    validusers: yourname
    writelist: yourname
    veto: no
    # Time Machine is enabled globally by the image; size is capped by the
    # ZFS quota on tank/backups/timemachine, not here.
