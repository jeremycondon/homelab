{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "enabledManagers": ["docker-compose"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Rolling tags (latest/stable/1/11) only change digest; batch those into one weekly PR",
      "matchUpdateTypes": ["digest"],
      "groupName": "image digests"
    },
    {
      "description": "Major DB / app upgrades need a manual migration plan",
      "matchPackageNames": ["mariadb", "louislam/uptime-kuma"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
